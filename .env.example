# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# OmniRoute Configuration
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_KEY=your_omniroute_api_key_here

# Optional: Your Discord User ID for owner-only commands
OWNER_ID=your_discord_user_id_here

# Optional: Guild ID for instant slash command registration
# (get it via right-click server -> Copy Server ID)
GUILD_ID=your_guild_id_here

# Sports & betting
# Get a free key at https://the-odds-api.com (500 req/month) for real betting lines
ODDS_API_KEY=your_odds_api_key_here
# Channel where Carl announces random games (leave empty to auto-pick server main/general)
ANNOUNCE_CHANNEL_ID=your_channel_id_here
CARL_COIN_START=1000
CARL_COIN_CLAIM=100
ANNOUNCE_MIN_HOURS=2
ANNOUNCE_MAX_HOURS=5
RESOLVE_MINUTES=5

# How often Carl randomly volunteers insider gossip he overheard (hours)
GOSSIP_MIN_HOURS=2
GOSSIP_MAX_HOURS=6